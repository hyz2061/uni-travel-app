<template>
  <div class="chat-page">
    <div class="nav-bar">
      <div class="back-btn" @click="goBack">
        <span class="arrow-icon">‹</span> 返回
      </div>
      <div class="nav-title">AI助手 小迹</div>
      <div class="placeholder"></div> 
    </div>

    <scroll-view 
      class="chat-container" 
      scroll-y="true" 
      :scroll-top="scrollTop"
      :scroll-into-view="lastMsgId"
      :scroll-with-animation="true"
    >
      <div class="chat-list">
        <div 
          v-for="(msg, index) in messageList" 
          :key="msg.id" 
          :id="'msg-' + index"
          class="message-item"
          :class="msg.role === 'user' ? 'message-self' : 'message-ai'"
        >
          <div class="time-stamp" v-if="msg.showTime">{{ msg.time }}</div>

          <div class="bubble-group">
            <img 
              :src="msg.role === 'user' ? '/static/头像.png' : '/static/logo1.png'" 
              class="avatar" 
            />
            
            <div class="bubble-content">
              <div class="text">{{ msg.content }}</div>
            </div>
          </div>
        </div>

        <div class="message-item message-ai" v-if="isAiTyping" id="ai-typing">
          <img src="/static/logo1.png" class="avatar" />
          <div class="bubble-content typing-bubble">
            <span class="dot">.</span><span class="dot">.</span><span class="dot">.</span>
          </div>
        </div>
      </div>
      
      <div style="height: 20px;"></div>
    </scroll-view>

    <div class="input-area">
      <input 
        type="text" 
        class="chat-input" 
        v-model="inputContent" 
        placeholder="想去哪里玩？问问小迹吧..."
        confirm-type="send"
        @confirm="sendMessage"
      />
      <button 
        class="send-btn" 
        :class="{ 'disabled': !inputContent.trim() }" 
        @click="sendMessage"
      >
        发送
      </button>
    </div>
  </div>
</template>

<script>
export default {
  data() {
    return {
      inputContent: '',
      scrollTop: 0,
      lastMsgId: '',
      isAiTyping: false,
      messageList: [
        {
          id: 1,
          role: 'ai',
          content: '你好呀！我是你的专属旅行助手“小迹” 🦜。',
          time: '09:41',
          showTime: true
        },
        {
          id: 2,
          role: 'ai',
          content: '无论是做攻略、查天气还是记账，我都可以帮你哦！你想去哪里玩呢？',
          time: '09:41',
          showTime: false
        }
      ]
    };
  },
  methods: {
    // 返回上一页
    goBack() {
      uni.navigateBack();
    },
    
    sendMessage() {
      const text = this.inputContent.trim();
      if (!text) return;

      this.addMessage('user', text);
      this.inputContent = '';

      this.isAiTyping = true;
      this.scrollToBottom();

      setTimeout(() => {
        this.isAiTyping = false;
        const replyText = this.getAiReply(text);
        this.addMessage('ai', replyText);
      }, 1200);
    },

    addMessage(role, content) {
      const now = new Date();
      const timeStr = `${now.getHours().toString().padStart(2, '0')}:${now.getMinutes().toString().padStart(2, '0')}`;
      
      this.messageList.push({
        id: Date.now(),
        role: role,
        content: content,
        time: timeStr,
        showTime: false
      });

      this.scrollToBottom();
    },

    scrollToBottom() {
      this.$nextTick(() => {
        this.lastMsgId = 'msg-' + (this.messageList.length - 1);
      });
    },

    getAiReply(question) {
      const q = question.toLowerCase();
      if (q.includes('西安')) return '西安是个好地方！兵马俑是必去的，晚上一定要去大唐不夜城感受盛唐风貌。如果您需要具体的《三天两夜行程》，我可以发给您哦！';
      if (q.includes('天气')) return '最近换季天气多变，出门旅行记得查好目的地天气，带把雨伞总是没错的。☔️';
      if (q.includes('攻略') || q.includes('计划')) return '做攻略交给我！告诉我你想去的【城市】和【天数】，我立马为您生成一份超详细的懒人计划！📝';
      if (q.includes('钱') || q.includes('经费') || q.includes('预算')) return '旅行经费建议提前规划。您可以在首页的“经费”页面记账，我会帮您统计每一笔开销，防止超支哦！💰';
      if (q.includes('你好') || q.includes('嗨') || q.includes('hello')) return '嗨！很高兴见到你，准备好出发去探索世界了吗？🌍';
      
      const defaultReplies = [
        '这个问题难倒小迹了，不过听起来很有趣！🤔',
        '收到！正在为您搜索全网最热门的旅行资讯...',
        '世界那么大，我们一起去看看吧！您可以试试问我关于“目的地”的问题。',
        '我不确定我是否理解了，不过您可以问我关于“订票”、“景点”或“美食”的问题哦！'
      ];
      return defaultReplies[Math.floor(Math.random() * defaultReplies.length)];
    }
  }
};
</script>

<style scoped>
/* 全局容器：蓝色背景 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #2CB8F9; /* 蓝色背景 */
  font-family: -apple-system, BlinkMacSystemFont, "Microsoft YaHei", sans-serif;
}

/* 1. 顶部导航栏 */
.nav-bar {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  padding-top: 40px; 
  color: #fff;
  font-size: 18px;
  font-weight: bold;
  box-sizing: content-box;
}
.back-btn {
  display: flex;
  align-items: center;
  font-size: 16px;
  cursor: pointer;
  width: 60px;
}
.arrow-icon {
  font-size: 24px;
  margin-right: 4px;
  margin-top: -4px;
}
.nav-title {
  flex: 1;
  text-align: center;
}
.placeholder {
  width: 60px;
}

/* 2. 聊天列表区域 */
.chat-container {
  flex: 1;
  padding: 16px;
  box-sizing: border-box;
  overflow-y: auto;
}

.chat-list {
  display: flex;
  flex-direction: column;
}

.message-item {
  margin-bottom: 20px;
  display: flex;
  flex-direction: column;
}

.time-stamp {
  text-align: center;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8); /* 时间戳半透明白 */
  margin-bottom: 10px;
}

.bubble-group {
  display: flex;
  align-items: flex-start;
  max-width: 80%;
}

.avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 1px solid #fff;
  background-color: #fff;
  flex-shrink: 0;
  object-fit: cover;
}

.bubble-content {
  padding: 12px 16px;
  border-radius: 12px;
  font-size: 15px;
  line-height: 1.5;
  position: relative;
  word-wrap: break-word;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

/* --- AI 样式 (左侧) --- */
.message-ai {
  align-items: flex-start;
}
.message-ai .bubble-group {
  flex-direction: row;
}
.message-ai .avatar {
  margin-right: 10px;
}
.message-ai .bubble-content {
  background-color: #FFFFFF; /* 白底黑字 */
  color: #333;
  border-top-left-radius: 2px;
}

/* --- 用户样式 (右侧) --- */
.message-self {
  align-items: flex-end;
}
.message-self .bubble-group {
  flex-direction: row-reverse;
}
.message-self .avatar {
  margin-left: 10px;
}
.message-self .bubble-content {
  background-color: #FCD653; /* 黄底黑字 */
  color: #000;
  border-top-right-radius: 2px;
}

/* 正在输入动画 */
.typing-bubble {
  padding: 12px 20px;
  background-color: #fff;
  border-radius: 12px;
  border-top-left-radius: 2px;
  margin-left: 10px;
}
.dot {
  display: inline-block;
  animation: typing 1.4s infinite ease-in-out both;
  font-size: 20px;
  line-height: 10px;
  margin: 0 1px;
  color: #999;
}
.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }
@keyframes typing {
  0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* 3. 底部输入框区域 */
.input-area {
  background-color: #fff;
  padding: 10px 16px;
  padding-bottom: calc(10px + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  border-top: 1px solid rgba(255,255,255,0.3);
}

.chat-input {
  flex: 1;
  background-color: #F5F7FA;
  height: 40px;
  border-radius: 20px;
  padding: 0 16px;
  font-size: 15px;
  margin-right: 12px;
  color: #333;
}

.send-btn {
  width: 70px;
  height: 36px;
  line-height: 36px;
  background-color: #2CB8F9;
  color: #fff;
  font-size: 14px;
  font-weight: bold;
  border-radius: 18px;
  text-align: center;
  padding: 0;
  border: none;
  transition: opacity 0.3s;
}
.send-btn.disabled {
  background-color: #ccc;
  pointer-events: none;
}
.send-btn::after { border: none; }
</style>